# Board defaults for ESP32-C6 (this file is applied automatically for esp32c6 builds).
# Only target-specific, role-independent settings belong here: the bridge role is
# left to the Kconfig default, which resolves to wireless slave on this target
# because the chip has no USB OTG controller.
#
# Build with:
#   idf.py -B build_c6 set-target esp32c6
#   idf.py -B build_c6 build
CONFIG_IDF_TARGET="esp32c6"

# Module flash: 4 MB (raise this if the module carries more).
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

# Debug probe: CMSIS-DAP over SWD. The USB-JTAG interface is not available on this
# target, so SWD has to be selected explicitly (the component default is JTAG).
CONFIG_DEBUG_PROBE_IFACE_SWD=y
CONFIG_DEBUG_PROBE_GPIO_TCK=4
CONFIG_DEBUG_PROBE_GPIO_TMS=5
# TDI/TDO are JTAG-only signals and are not driven in SWD mode, so they keep the
# component defaults (3/9).

# Target UART and reset lines. BOOT sits on GPIO10, not GPIO8: GPIO8 is the
# addressable RGB LED of the devkit and is used by the status LED below.
CONFIG_TARGET_UART_GPIO_BOOT=10
CONFIG_TARGET_UART_GPIO_RST=9
CONFIG_TARGET_UART_GPIO_RXD=6
CONFIG_TARGET_UART_GPIO_TXD=7

# Pin map above is the one that was verified on the actual C6 slave board during
# stage 3 (SWCLK=4, SWDIO=5, target TXD=7, target RXD=6, RST=9); BOOT moved from
# GPIO8 to GPIO10 when the status LED took GPIO8. Re-check it when the board
# changes: GPIO 8/9/15 are strapping pins on the C6, so a different carrier board
# may sample different levels at reset.

# Status LED: WS2812 data input on GPIO8, the addressable RGB LED of the devkit.
# Set CONFIG_BRIDGE_WS2812_GPIO to -1 (or turn CONFIG_BRIDGE_LED_ENABLE off, menu
# "END-config -> Pin configuration -> Status LED") on a board without one.
CONFIG_BRIDGE_LED_ENABLE=y
CONFIG_BRIDGE_WS2812_GPIO=8
CONFIG_BRIDGE_LED_BRIGHTNESS=16
CONFIG_BRIDGE_LED_ACT_WINDOW_MS=1000
CONFIG_BRIDGE_LED_BLINK_PERIOD_MS=1000
CONFIG_BRIDGE_LED_BLINK_ON_MS=500
CONFIG_BRIDGE_LED_BREATH_PERIOD_MS=1000
CONFIG_BRIDGE_LED_BREATH_MIN_PCT=0
CONFIG_BRIDGE_LED_GAMMA_X100=220

# Debug aids, deliberately off in the defaults (enable per build in menuconfig,
# "END-config -> Debug"; channel and timeouts live in "END-config -> Wireless link"):
#   CONFIG_WLINK_SWD_VERBOSE_LOG=y   log every CMSIS-DAP packet (queued / seq N sent)
#   CONFIG_WLINK_DEBUG_LINK_TEST=y   slave sends "connected N" once per second
# They stay off by default because the link test writes into the target's serial
# stream (it goes out as WLINK_MSG_SERIAL) and the verbose log costs throughput.
