menu "Bridge Configuration"

    choice BRIDGE_ROLE
        prompt "Bridge role"
        default BRIDGE_ROLE_WIRED if SOC_USB_OTG_SUPPORTED
        default BRIDGE_ROLE_WIRELESS_SLAVE
        help
            Select which end of the bridge this firmware implements.

            Wired: a single chip carrying both ends, USB on one side and the target
            UART/JTAG/SWD plus the mass storage disk on the other.

            Wireless host: sits next to the PC. USB CDC and the CMSIS-DAP bulk
            interface are tunnelled over ESP-NOW to a wireless slave.

            Wireless slave: sits next to the target. Drives the target UART, the
            BOOT/RST pins and the CMSIS-DAP/SWD pins from the ESP-NOW link.

            Wired and wireless host need a USB OTG device controller, so they are
            only offered on targets that have one (ESP32-S2/S3/P4/H4). Targets
            without USB OTG (ESP32-C3/C6, ...) only offer the wireless slave.

            Both wireless roles require "Debug Probe Configuration -> CMSIS-DAP SWD".

        config BRIDGE_ROLE_WIRED
            bool "Wired (USB only)"
            depends on SOC_USB_OTG_SUPPORTED

        config BRIDGE_ROLE_WIRELESS_HOST
            bool "Wireless host (USB <-> ESP-NOW)"
            depends on SOC_USB_OTG_SUPPORTED

        config BRIDGE_ROLE_WIRELESS_SLAVE
            bool "Wireless slave (ESP-NOW <-> target UART + SWD)"
    endchoice

    config BRIDGE_USB_VID
        hex "USB vendor ID"
        default 0x303A
        help
            USB Vendor ID for the bridge device

    config BRIDGE_USB_PID
        hex "USB product ID"
        default 0x1002
        help
            USB Product ID for the bridge device

    config BRIDGE_MANUFACTURER
        string "USB bridge manufacturer"
        default "Espressif Systems Co. Ltd."
        help
            Manufacturer string shown in USB device descriptor

    config BRIDGE_PRODUCT_NAME
        string "USB product name"
        default "ESP USB Bridge"
        help
            Product name string shown in USB device descriptor

    config BRIDGE_LED_ENABLE
        bool "Drive the status LEDs (LED1..3)"
        default n
        help
            Drives the three discrete activity LEDs on BRIDGE_GPIO_LED1..3.

            Leave this disabled unless the board really has LEDs wired to those pins
            with the configured polarity. While disabled the pins are never
            configured, driven or reset, so they stay in their power-on state and
            cannot disturb whatever the board actually connects there.

            The pin and polarity options below are kept in both configurations
            because the LED code compiles against them either way; they are inert
            while this option is off.

            This option does not cover an addressable RGB LED; see
            BRIDGE_WS2812_GPIO.

    config BRIDGE_GPIO_LED1
        int "GPIO pin LED1"
        default 12
        help
            GPIO pin for LED1 (typically TX activity indicator). Only used when
            BRIDGE_LED_ENABLE is set.

    config BRIDGE_GPIO_LED2
        int "GPIO pin LED2"
        default 13
        help
            GPIO pin for LED2 (typically RX activity indicator). Only used when
            BRIDGE_LED_ENABLE is set.

    config BRIDGE_GPIO_LED3
        int "GPIO pin LED3"
        default 14
        help
            GPIO pin for LED3 (typically debug activity indicator). Only used when
            BRIDGE_LED_ENABLE is set.

    config BRIDGE_GPIO_LED1_ACTIVE
        int "GPIO pin LED1 active value"
        range 0 1
        default 0
        help
            Logic level when LED1 is active (0=active low, 1=active high). Only used
            when BRIDGE_LED_ENABLE is set.

    config BRIDGE_GPIO_LED2_ACTIVE
        int "GPIO pin LED2 active value"
        range 0 1
        default 0
        help
            Logic level when LED2 is active (0=active low, 1=active high). Only used
            when BRIDGE_LED_ENABLE is set.

    config BRIDGE_GPIO_LED3_ACTIVE
        int "GPIO pin LED3 active value"
        range 0 1
        default 0
        help
            Logic level when LED3 is active (0=active low, 1=active high). Only used
            when BRIDGE_LED_ENABLE is set.

    config BRIDGE_WS2812_GPIO
        int "GPIO reserved for a WS2812 status LED (-1 = none)"
        default -1
        help
            GPIO number reserved for an addressable RGB status LED (WS2812/WS2812B),
            or -1 to reserve nothing.

            No driver is implemented yet: this option only records the intent and
            led_rgb_init() merely validates the pin. The pin is left in its reset
            state - it is never configured, driven or pulsed - so naming a pin on a
            board without such an LED does not disturb anything either.

            led_rgb_init() rejects a pin outside the chip's GPIO range, and a pin
            already used by the target UART, the debug probe or the activity LEDs.

            The eventual driver needs a peripheral that can emit 800 kHz pulse
            trains (RMT is the usual choice), plus a 5 V supply and level shifting
            on most WS2812 parts.

    config BRIDGE_MSC_VOLUME_LABEL
        string "Volume label shown in the MSC disc"
        default "ESPPROG_MSC"
        help
            Volume label shown in the MSC disc. Max length is 11 ASCII characters.

    config BRIDGE_DOWNLOAD_MAGIC_BAUD
        int "Magic baud rate to enter download mode"
        default 1200
        help
            When the host sets the CDC serial port to this baud rate, download
            mode reset is armed. Closing the port (clearing DTR) then resets the
            bridge chip (ESP32-S2 or ESP32-S3) into download mode so its firmware
            can be updated over USB. Do not use this baud for normal target
            serial traffic; any DTR clear while armed triggers bridge download
            mode. Prefer a baud that host tools will not use for the target.
            Set to 0 to disable.

endmenu
