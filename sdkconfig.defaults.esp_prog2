# This file is used to pass ESP-Prog-2 specific options when building firmware for the probe
# To pass it to the build system, set the SDKCONFIG_DEFAULTS environment environment variable like so:
# export SDKCONFIG_DEFAULTS="sdkconfig.defaults.esp_prog2;sdkconfig.defaults.esp32s3"

CONFIG_BRIDGE_PRODUCT_NAME="ESP-Prog-2"

CONFIG_SERIAL_HANDLER_GPIO_BOOT=33
CONFIG_SERIAL_HANDLER_GPIO_RST=21
CONFIG_SERIAL_HANDLER_GPIO_RXD=18
CONFIG_SERIAL_HANDLER_GPIO_TXD=17

CONFIG_DEBUG_PROBE_GPIO_TDI=7
CONFIG_DEBUG_PROBE_GPIO_TDO=6
CONFIG_DEBUG_PROBE_GPIO_TCK=5
CONFIG_DEBUG_PROBE_GPIO_TMS=4

# Status LED: none configured. CONFIG_BRIDGE_LED_ENABLE is off by default, so no pin is
# driven. Espressif does not publish the ESP-Prog-2 schematic and the RGB LED on this
# board is a WS2812 (needs the RMT driver, see CONFIG_BRIDGE_WS2812_GPIO), so no LED pin
# is guessed here: use "END-config -> Pin configuration -> Status LED" once it is known.
