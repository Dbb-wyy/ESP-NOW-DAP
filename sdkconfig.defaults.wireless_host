# Wireless host: sits next to the PC, tunnels USB CDC + CMSIS-DAP over ESP-NOW.
# Board pins / flash come from sdkconfig.defaults.esp32s3.
#
# This is also the Kconfig default role on chips with a USB OTG controller, so the file
# mainly pins CONFIG_BRIDGE_ROLE_WIRELESS_HOST explicitly: a build that points
# SDKCONFIG at a different file keeps working no matter what the default is.
#
# Build with:
#   idf.py -B build_host -D SDKCONFIG=sdkconfig.host \
#          -D SDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.defaults.wireless_host" build
CONFIG_BRIDGE_ROLE_WIRELESS_HOST=y
CONFIG_WLINK_CHANNEL=1

# Performance trial: ESP-NOW defaults to 1 Mbps, which spends ~1 ms of airtime per
# 64 byte DAP packet. Drop back to CONFIG_WLINK_TX_RATE_1M=y if the link turns out
# flaky at range or under interference.
CONFIG_WLINK_TX_RATE_54M=y
