# Board defaults for ESP32-C3 (this file is applied automatically for esp32c3 builds).
# Only target-specific, role-independent settings belong here: the bridge role is
# left to the Kconfig default, which resolves to wireless slave on this target
# because the chip has no USB OTG controller.
#
# Build with:
#   idf.py -B build_c3 set-target esp32c3
#   idf.py -B build_c3 build
CONFIG_IDF_TARGET="esp32c3"

# Module flash: 4 MB (raise this if the module carries more).
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

# Debug probe: CMSIS-DAP over SWD. The USB-JTAG interface is not available on this
# target, so SWD has to be selected explicitly (the component default is JTAG).
CONFIG_DEBUG_PROBE_IFACE_SWD=y
CONFIG_DEBUG_PROBE_GPIO_TCK=10
CONFIG_DEBUG_PROBE_GPIO_TMS=11
# TDI/TDO are JTAG-only signals and are not driven in SWD mode, so they keep the
# component defaults (3/9).

# Target UART and reset lines.
CONFIG_SERIAL_HANDLER_GPIO_BOOT=6
CONFIG_SERIAL_HANDLER_GPIO_RST=7
CONFIG_SERIAL_HANDLER_GPIO_RXD=5
CONFIG_SERIAL_HANDLER_GPIO_TXD=4

# No status LED pins here: CONFIG_BRIDGE_LED_ENABLE is off by default, so no LED pin
# is ever configured. This matters especially on this chip, where GPIO 12-17 belong
# to the in-package SPI flash and GPIO 11 is VDD_SPI: driving them would break the
# flash and the SWD pins, and a wrong pin here only shows up at run time, never at
# build time. Pick the LEDs and the probe/UART pins together once the C3 board is in
# hand (stage 4).
# The TMS=11 above is the same kind of problem (GPIO 11 is VDD_SPI) and is also left
# for stage 4, where the whole pin map gets re-checked against the real board.
