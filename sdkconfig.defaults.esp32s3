# Board defaults for ESP32-S3 (this file is applied automatically for esp32s3 builds).
# Values mirror the settings that were previously only present in the local sdkconfig,
# so that every build directory / role ends up with the same hardware configuration.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y

# Module is an ESP32-S3-WROOM-1 N16R8: 16 MB flash, 8 MB octal PSRAM (PSRAM left unused).
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# Debug probe: CMSIS-DAP over SWD (the wireless roles require this).
CONFIG_DEBUG_PROBE_IFACE_SWD=y
CONFIG_DEBUG_PROBE_GPIO_TDI=3
CONFIG_DEBUG_PROBE_GPIO_TDO=9
CONFIG_DEBUG_PROBE_GPIO_TCK=17
CONFIG_DEBUG_PROBE_GPIO_TMS=18

# Target UART and reset lines.
CONFIG_SERIAL_HANDLER_GPIO_BOOT=4
CONFIG_SERIAL_HANDLER_GPIO_RST=7
CONFIG_SERIAL_HANDLER_GPIO_RXD=6
CONFIG_SERIAL_HANDLER_GPIO_TXD=5

# Status LEDs and USB identity.
CONFIG_BRIDGE_GPIO_LED1=12
CONFIG_BRIDGE_GPIO_LED2=13
CONFIG_BRIDGE_GPIO_LED3=14
CONFIG_BRIDGE_USB_VID=0x303A
CONFIG_BRIDGE_USB_PID=0x1002
CONFIG_BRIDGE_MSC_VOLUME_LABEL="ESPPROG_MSC"
CONFIG_BRIDGE_DOWNLOAD_MAGIC_BAUD=1200
